# ==========================================
# Prime Mobile Inventory - Environment Configuration
# ==========================================

# PostgreSQL Credentials
POSTGRES_DB=primemobile_db
POSTGRES_USER=primemobile
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_PORT=5432

# Microservices Ports (Local development)
PARSER_PORT=5000
BACKEND_PORT=8080
FRONTEND_PORT=80

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=generate_random_64_char_hex_or_base64_secret_key_for_production_security
JAVA_OPTS=-XX:+UseSerialGC -Xms256m -Xmx384m -XX:+ExitOnOutOfMemoryError

# Domain & Host Configuration
DOMAIN=inventory.primemobile.hu
